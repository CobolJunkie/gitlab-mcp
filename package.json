{
  "name": "@local/gitlab-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Inspect GitLab projects, triage merge requests and issues, debug CI/CD, address review feedback, and publish changes.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "adapters:generate": "node scripts/adapters-generate.mjs",
    "adapters:check": "node scripts/adapters-generate.mjs --check",
    "benchmark:surface": "node scripts/benchmark-surface.mjs",
    "benchmark:surface:check": "node scripts/benchmark-surface.mjs --check",
    "benchmark:workload": "node scripts/benchmark-workload.mjs",
    "benchmark:workload:check": "node scripts/benchmark-workload.mjs --check",
    "benchmark:workload:live": "node scripts/benchmark-workload-live.mjs",
    "benchmark:workload:promote": "node scripts/promote-workload-baseline.mjs",
    "build": "node scripts/build.mjs",
    "check": "node --check server/src/index.mjs",
    "lint": "eslint server/src server/test test test-dependency-boundaries scripts shared adapters .dependency-cruiser.mjs .dependency-cruiser-rules.mjs eslint.config.mjs",
    "format": "prettier --write \"*.md\" package.json package-lock.json distribution.json benchmarks .gitlab .gitlab-ci.yml eslint.config.mjs .prettierrc.json .dependency-cruiser.mjs .dependency-cruiser-rules.mjs server/src server/test test test-dependency-boundaries scripts shared adapters docs",
    "format:check": "prettier --check \"*.md\" package.json package-lock.json distribution.json benchmarks .gitlab .gitlab-ci.yml eslint.config.mjs .prettierrc.json .dependency-cruiser.mjs .dependency-cruiser-rules.mjs server/src server/test test test-dependency-boundaries scripts shared adapters docs",
    "check:bundle": "node scripts/build.mjs --check",
    "check:gitlab-oauth": "node scripts/check-gitlab-oauth.mjs",
    "check:versions": "node --test server/test/version.test.mjs",
    "check:mcp-deployment": "node scripts/check-mcp-deployment.mjs",
    "check:mcp-surface-parity": "node scripts/check-mcp-surface-parity.mjs",
    "deps:check": "depcruise server/src scripts skills shared adapters",
    "release:validate": "npm run adapters:check && npm run validate:harnesses && npm run validate:release-set",
    "smoke:docker": "node scripts/docker-smoke.mjs",
    "test:integration": "node scripts/integration-smoke.mjs",
    "test:integration:disposable": "node scripts/validate-disposable-integration-report.mjs --prepare && node scripts/integration-disposable.mjs && node scripts/validate-disposable-integration-report.mjs",
    "test": "node --test --test-reporter=spec",
    "test:ci": "node -e \"require('node:fs').mkdirSync('artifacts/test-results', { recursive: true })\" && node --test --test-reporter=spec --test-reporter=junit --test-reporter-destination=stdout --test-reporter-destination=artifacts/test-results/junit.xml",
    "test:coverage": "node -e \"require('node:fs').mkdirSync('coverage', { recursive: true })\" && node --test --experimental-test-coverage --test-coverage-include=server/src/**/*.mjs --test-coverage-include=shared/**/*.mjs --test-coverage-include=adapters/**/*.mjs --test-coverage-include=scripts/lib/**/*.mjs --test-coverage-include=scripts/check-gitlab-oauth.mjs --test-coverage-include=scripts/check-mcp-candidate.mjs --test-coverage-include=scripts/check-mcp-surface-parity.mjs --test-coverage-include=scripts/check-mcp-deployment.mjs --test-coverage-include=scripts/check-mcp-runtime.mjs --test-coverage-include=scripts/deploy-production.mjs --test-coverage-include=scripts/deterministic-git-archive.mjs --test-coverage-include=scripts/docker-entrypoint.mjs --test-coverage-include=scripts/harness-package-validation.mjs --test-coverage-include=scripts/integration-report.mjs --test-coverage-lines=90 --test-coverage-functions=80 --test-coverage-branches=75 --test-reporter=spec --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=coverage/lcov.info",
    "validate:codex": "node scripts/release-validate.mjs && node scripts/validate-codex-adapter.mjs",
    "validate:claude": "node scripts/validate-claude-adapter.mjs",
    "validate:cline": "node scripts/validate-cline-adapter.mjs",
    "validate:pi": "node scripts/validate-pi-adapter.mjs",
    "validate:harnesses": "npm run validate:codex && npm run validate:claude && npm run validate:cline && npm run validate:pi",
    "validate:release-set": "node scripts/validate-cross-harness-release.mjs",
    "smoke": "node scripts/smoke-bundle.mjs",
    "start": "node server/src/index.mjs --stdio",
    "start:http": "node server/src/index.mjs --http"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.221.0",
    "@opentelemetry/instrumentation-host-metrics": "0.3.0",
    "@opentelemetry/instrumentation-http": "0.221.0",
    "@opentelemetry/instrumentation-runtime-node": "0.34.0",
    "@opentelemetry/instrumentation-undici": "0.31.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "express": "5.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "dependency-cruiser": "^16.10.4",
    "esbuild": "0.25.9",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "js-yaml": "^4.3.1",
    "prettier": "^3.6.2"
  },
  "overrides": {
    "@hono/node-server": "2.0.11"
  }
}
